# Managed by Ansible (agent-browser role).
[Unit]
Description=Forward port {{ agent_browser_browseros_mcp_public_port }} to BrowserOS's MCP server, wherever it listens
PartOf=agent-browser.target

[Service]
ExecStart=/usr/local/bin/browseros-mcp-forward
Restart=always
RestartSec=5

[Install]
WantedBy=agent-browser.target
