# Managed by Ansible (agent-browser role).
[Unit]
Description=Forward port {{ agent_browser_browseros_mcp_public_port }} to BrowserOS's MCP server (localhost only)
PartOf=agent-browser.target

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:{{ agent_browser_browseros_mcp_public_port }},fork,reuseaddr TCP:127.0.0.1:{{ agent_browser_browseros_mcp_port }}
Restart=always
RestartSec=5

[Install]
WantedBy=agent-browser.target
